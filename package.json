{
  "name": "lucent",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --cwd apps/website dev",
    "build": "bun run --cwd apps/website build",
    "start": "bun run --cwd apps/website preview",
    "preview": "bun run --cwd apps/website preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p fixtures",
    "build:packages": "bun scripts/build-packages.ts",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "bun test",
    "verify": "bun run typecheck && bun run lint && bun run format:check && bun test && bun scripts/verify-native.ts",
    "doctor": "bun scripts/doctor.ts",
    "lucent": "bun packages/cli/src/main.ts"
  },
  "devDependencies": {
    "@lucent/backend-kotlin": "workspace:*",
    "@lucent/backend-swift": "workspace:*",
    "@lucent/compiler": "workspace:*",
    "@lucent/types": "workspace:*",
    "@types/bun": "^1.2.0",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "typescript": "~5.9.3"
  }
}
