{
  "name": "lucent",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p fixtures",
    "lint": "vp lint --deny-warnings",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "test": "vp test run",
    "test:watch": "vp test",
    "build:packages": "vp pack",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && tsx scripts/verify-native.ts",
    "lucent": "tsx packages/cli/src/main.ts",
    "tools": "tsx scripts/doctor.ts"
  },
  "devDependencies": {
    "@lucent-lang/backend-kotlin": "workspace:*",
    "@lucent-lang/backend-swift": "workspace:*",
    "@lucent-lang/compiler": "workspace:*",
    "@lucent-lang/types": "workspace:*",
    "@types/node": "^24.7.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@12.5.1"
}
