{
  "name": "lucent",
  "version": "0.0.3",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vp test",
    "test:runtime": "packages/runtime/test/run.sh",
    "test:e2e": "tsx packages/compiler/test/e2e/run.ts",
    "website": "pnpm --filter @lucent-lang/website dev",
    "website:build": "pnpm --filter @lucent-lang/website build",
    "lucent": "tsx packages/lucent/src/cli/main.ts"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "overrides": {
      "vite": "catalog:"
    },
    "peerDependencyRules": {
      "allowAny": [
        "vite"
      ]
    }
  }
}
