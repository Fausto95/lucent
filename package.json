{
  "name": "lucent",
  "version": "0.1.0-cpp",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:runtime": "packages/runtime/test/run.sh",
    "test:e2e": "tsx packages/compiler/test/e2e/run.ts",
    "lucent": "tsx packages/cli/src/main.ts"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@9.1.2"
}
