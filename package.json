{
  "name": "lucent",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p fixtures",
    "lint": "vp lint --deny-warnings",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "test": "vp test run",
    "test:watch": "vp test",
    "build:packages": "vp pack",
    "website": "pnpm --filter @lucent-lang/website dev",
    "website:build": "pnpm --filter @lucent-lang/website build",
    "verify": "tsx scripts/embed-native.ts --check && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && tsx scripts/verify-native.ts && tsx scripts/verify-runtime.ts && tsx scripts/verify-interop.ts && tsx scripts/verify-cancellation.ts && tsx scripts/verify-enums.ts && tsx scripts/verify-numeric-widening.ts && tsx scripts/verify-symbolgraph.ts && tsx scripts/verify-task-scopes.ts && tsx scripts/verify-delegates.ts && tsx scripts/verify-camera-frames.ts",
    "lucent": "tsx packages/cli/src/main.ts",
    "tools": "pnpm --filter expo-example exec tsx ../../packages/cli/src/main.ts doctor",
    "embed:native": "tsx scripts/embed-native.ts"
  },
  "devDependencies": {
    "@lucent-lang/backend-kotlin": "workspace:*",
    "@lucent-lang/backend-swift": "workspace:*",
    "@lucent-lang/compiler": "workspace:*",
    "@lucent-lang/core": "workspace:*",
    "@types/node": "^24.7.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.3",
    "vite-plus": "0.3.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@9.1.2",
  "pnpm": {
    "overrides": {
      "vite@*": "npm:@voidzero-dev/vite-plus-core@0.3.3",
      "vitest@*": "4.1.11"
    },
    "peerDependencyRules": {
      "allowAny": [
        "vite",
        "vitest"
      ],
      "allowedVersions": {
        "vite": "*",
        "vitest": "*"
      }
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
