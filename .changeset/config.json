{
  "$schema": "../node_modules/@changesets/config/schema.json",
  "baseBranch": "main",
  "access": "public",
  "changelog": [
    "@changesets/changelog-github",
    {
      "repo": "Fausto95/lucent"
    }
  ],
  "commit": false,
  "format": false,
