{
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    "baseUrl": ".",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [
      "node",
      "@docusaurus/module-type-aliases"
    ],
    "paths": {
      "@site/*": [
        "./*"
      ],
      "~/*": [
        "./src/*"
      ]
    },
    "target": "ES2023",
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx"
  },
  "include": [
    "src",
    "test",
    "docusaurus.config.ts",
    "sidebars.ts"
  ],
  "exclude": [
    "build",
    ".docusaurus",
    ".prose",
    "src/generated/snippets"
  ]
}
