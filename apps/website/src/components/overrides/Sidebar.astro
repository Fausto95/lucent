---
/**
 * Six's sidebar, steady across pages. Its own version expands and spaces
 * groups after load, and starts every page scrolled to the top; this one
 * renders groups as they'll stay, and the script below runs as soon as the
 * sidebar is parsed, before the first paint, to collapse the groups a reader
 * closed and put the sidebar back where it was scrolled.
 */
import SidebarGroups from "./SidebarGroups.astro";

const { sidebar } = Astro.locals.starlightRoute;
---

<div class="sidebar">
  <div class="container-sidebar">
    <SidebarGroups sublist={sidebar} />
  </div>
</div>

<script is:inline>
  (() => {
    const pane = document.currentScript?.previousElementSibling;
    if (!pane) return;
    const read = (store, key) => {
      try {
        return store.getItem(key);
      } catch {
        return null;
      }
    };
    const write = (store, key, value) => {
      try {
        store.setItem(key, value);
      } catch {}
    };
    const setCollapsed = (group, collapsed) => {
      group.classList.toggle("collapsed", collapsed);
      group.classList.toggle("is-expanded", !collapsed);
      group.querySelector(":scope > [data-group-toggle]")?.setAttribute("aria-expanded", String(!collapsed));
    };

    // Groups the reader collapsed (the key Six uses, so earlier choices carry over).
    for (const group of pane.querySelectorAll("[data-group]")) {
      const key = `sidebar-${group.dataset.group}`;
      if (read(localStorage, key) === "true") setCollapsed(group, true);
      group.querySelector(":scope > [data-group-toggle]")?.addEventListener("click", () => {
        const collapsed = !group.classList.contains("collapsed");
        setCollapsed(group, collapsed);
        write(localStorage, key, String(collapsed));
      });
    }

    // Where the sidebar was scrolled, as long as the current page shows; else the current page in view.
    pane.scrollTop = Number(read(sessionStorage, "lucent-sidebar-scroll")) || 0;
    const current = pane.querySelector('[aria-current="page"]');
    if (current) {
      const top = current.offsetTop - pane.scrollTop;
      if (top < 0 || top + current.offsetHeight > pane.clientHeight)
        pane.scrollTop = current.offsetTop - pane.clientHeight / 3;
    }
    const save = () => write(sessionStorage, "lucent-sidebar-scroll", String(pane.scrollTop));
    addEventListener("pagehide", save);
    pane.addEventListener("click", (event) => {
      if (event.target instanceof Element && event.target.closest("a")) save();
    });
  })();
</script>
