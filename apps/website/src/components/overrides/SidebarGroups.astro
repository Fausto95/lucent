---
/**
 * Six's sidebar entries, as React Native's docs show theirs: a group starts
 * collapsed unless it holds the current page, and may hold sub-groups.
 * Sidebar.astro's inline script opens the groups a reader opened before the
 * page paints, so nothing moves after load.
 */
import type { StarlightRouteData } from "@astrojs/starlight/route-data";
import { holdsCurrent } from "../../docs/sections";

interface Props {
  sublist: StarlightRouteData["sidebar"];
  /** Whose groups these are (a docs section, the blog): a group's state is kept per scope. */
  scope: string;
  /** 0 for a section's groups, 1 for their sub-groups. */
  depth?: number;
}

const { sublist, scope, depth = 0 } = Astro.props;
---

{sublist.map((entry) =>
  entry.type === "link" ? (
    <a
      href={entry.href}
      aria-current={entry.isCurrent && "page"}
      class:list={["entry-link", entry.attrs.class]}
      title={entry.label}
      {...entry.attrs}
    >
      <span class="entry-label">{entry.label}</span>
      {entry.badge && <span class="entry-badge">{entry.badge.text}</span>}
    </a>
  ) : (
    <div
      class:list={[
        "container-sidebar-entry",
        holdsCurrent(entry) ? "is-expanded" : "collapsed",
        depth > 0 && "subgroup",
      ]}
      data-group={`${scope}/${entry.label}`}
      data-current={holdsCurrent(entry) ? "" : undefined}
    >
      <button
        class="entry-title-button"
        type="button"
        aria-expanded={holdsCurrent(entry) ? "true" : "false"}
        data-group-toggle
      >
        <h4 class="entry-title">{entry.label}</h4>
        <svg
          class="collapse-icon"
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m6 9 6 6 6-6" />
        </svg>
      </button>
      <div class="container-group-link">
        <Astro.self sublist={entry.entries} scope={scope} depth={depth + 1} />
      </div>
    </div>
  ),
)}

<style>
  /* Long titles remain fully readable, including on touch screens. */
  .entry-label {
    flex: 1 1 auto;
    min-width: 0;
    white-space: normal;
    overflow-wrap: anywhere;
    line-height: 1.45;
  }
  .entry-badge {
    flex-shrink: 0;
  }
  .container-sidebar-entry {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .container-sidebar-entry.is-expanded {
    margin-bottom: 1rem;
  }
  .subgroup {
    padding-left: 0.75rem;
  }
  .subgroup.is-expanded {
    margin-bottom: 0.5rem;
  }
  .subgroup .entry-title {
    font-weight: 500;
    color: var(--muted-foreground);
  }
  .entry-title-button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 0.5rem 0;
    border: none;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .entry-title-button:hover {
    color: var(--accent-foreground);
  }
  .entry-title {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 600;
  }
  .collapse-icon {
    flex-shrink: 0;
    width: 1rem;
    height: 1rem;
    transition: transform 0.2s ease-in-out;
  }
  .container-sidebar-entry.collapsed .collapse-icon {
    transform: rotate(-90deg);
  }
  .container-group-link {
    min-width: 0;
    grid-template-columns: minmax(0, 1fr);
  }
  .container-sidebar-entry.collapsed .container-group-link {
    display: none;
  }
</style>
