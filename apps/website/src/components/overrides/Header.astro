---
import ThemeSelect from "@six-tech/starlight-theme-six/overrides/ThemeSelect.astro";
import SocialIcons from "@six-tech/starlight-theme-six/overrides/SocialIcons.astro";
import Search from "./Search.astro";
---

<div class="docs-header">
  <a class="brand" href="/" aria-label="Lucent home">
    <img src="/brand/lucent-mark.svg" alt="" width="26" height="26" />
    <span>Lucent</span>
  </a>
  <nav aria-label="Main navigation">
    <a href="/docs/">Docs</a>
    <a href="/blog/">Blog</a>
  </nav>
  <div class="tools">
    <Search />
    <SocialIcons />
    <ThemeSelect />
    <button
      class="mobile-menu"
      type="button"
      popovertarget="drawer"
      aria-label="Open navigation"
    >
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        aria-hidden="true"
      >
        <path d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>
</div>
<style>
  .docs-header {
    display: flex;
    align-items: center;
    gap: 24px;
    width: 100%;
    min-width: 0;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 9px;
    color: var(--foreground);
    text-decoration: none;
    font-weight: 600;
    letter-spacing: -0.035em;
  }
  .brand img {
    flex: none;
  }
  nav {
    display: flex;
    gap: 20px;
    font-size: 14px;
  }
  nav a {
    color: var(--muted-foreground);
    text-decoration: none;
  }
  nav a:hover {
    color: var(--foreground);
  }
  .tools {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
  }
  .mobile-menu {
    display: none;
    background: transparent;
    border: 0;
    color: var(--foreground);
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
  }
  @media (max-width: 767px) {
    .docs-header {
      gap: 10px;
    }
    nav {
      display: none;
    }
    .brand span {
      display: none;
    }
    .mobile-menu {
      display: flex;
    }
    .tools {
      gap: 4px;
    }
    .tools :global(.social-icons) {
      display: none;
    }
  }
</style>
