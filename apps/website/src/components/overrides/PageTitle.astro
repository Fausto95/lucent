---
/**
 * Six's page title, with the page's sidebar group as its breadcrumb and the
 * description's inline markup (`code`, **strong**, [text](href)) rendered.
 */
import { docsGroups } from "../../docs/nav";
import { inlineHtml } from "../../docs/inline-html";

const { id, entry } = Astro.locals.starlightRoute;
const { title, template, description } = entry.data;
const slug = id === "docs" ? "" : id.replace(/^docs\//, "");
const group = docsGroups.find((g) => g.slugs.includes(slug))?.label ?? "Docs";
---

{
  template !== "splash" && (
    <>
      {id.startsWith("docs") && <div class="breadcrumb">{group}</div>}
      <h1 id="_top">{title}</h1>
      {description && <p set:html={inlineHtml(description)} />}
    </>
  )
}

<style>
  .breadcrumb {
    margin-bottom: 1rem;
    color: var(--muted-foreground);
    font-size: 0.875rem;
    line-height: 1;
  }
  h1 {
    margin: 0;
    color: var(--foreground-light);
    font-size: 2.25rem;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.025em;
    scroll-margin: 5rem;
  }
  @media (max-width: 50rem) {
    h1 {
      font-size: 1.75rem;
    }
  }
  p {
    margin: 0.5rem 0 0;
    color: var(--muted-foreground);
    font-size: 1rem;
    line-height: 1.5rem;
    text-wrap: balance;
  }
  p :global(code) {
    font-size: 0.9em;
  }
</style>
