---
/**
 * Six's page title, with the page's section and sidebar group as its
 * breadcrumb and the description's inline markup (`code`, **strong**,
 * [text](href)) rendered.
 */
import { locate, slugOfId } from "../../docs/nav";
import { inlineHtml } from "../../docs/inline-html";

const { id, entry } = Astro.locals.starlightRoute;
const { title, template, description } = entry.data;
const slug = slugOfId(id);
const at = slug === undefined ? undefined : locate(slug);
---

{template !== "splash" && (
  <>
    {at && <div class="breadcrumb">{at.section.label} · {at.group.label}</div>}
    <h1 id="_top">{title}</h1>
    {description && <p set:html={inlineHtml(description)} />}
  </>
)}

<style>
  .breadcrumb {
    margin-bottom: 1rem;
    color: var(--muted-foreground);
    font-size: 0.875rem;
    line-height: 1.5;
  }
  h1 {
    margin: 0;
    color: var(--foreground-light);
    font-size: 2.25rem;
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.025em;
    scroll-margin: 5rem;
  }
  @media (max-width: 50rem) {
    h1 {
      font-size: 1.75rem;
    }
  }
  p {
    margin: 0.5rem 0 0;
    color: var(--muted-foreground);
    font-size: 1rem;
    line-height: 1.5rem;
    text-wrap: pretty;
  }
  p :global(code) {
    font-size: 0.9em;
  }
</style>
