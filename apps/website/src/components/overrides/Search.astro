---
import "@pagefind/default-ui/css/ui.css";
---

<lucent-search>
  <button
    class="search-open"
    type="button"
    aria-label="Search documentation"
    aria-keyshortcuts="Control+K Meta+K"
  >
    <span>Search docs</span>
    <kbd>⌘ K</kbd>
  </button>
  <dialog aria-label="Search documentation">
    <div class="search-heading">
      <span>SEARCH LUCENT</span>
      <button class="search-close" type="button" aria-label="Close search">
        Close <kbd>Esc</kbd>
      </button>
    </div>
    <div class="search-body">
      <div class="search-mount"></div>
      <p class="search-hint" role="status">
        Search guides, APIs, and examples.
      </p>
    </div>
    <div class="search-footer">
      <span>Documentation &amp; guides</span>
      <span>
        <kbd>Tab</kbd> to navigate · <kbd>Enter</kbd> to open
      </span>
    </div>
  </dialog>
</lucent-search>

<script>
  class LucentSearch extends HTMLElement {
    connectedCallback() {
      const trigger = this.querySelector<HTMLButtonElement>(".search-open")!;
      const close = this.querySelector<HTMLButtonElement>(".search-close")!;
      const dialog = this.querySelector<HTMLDialogElement>("dialog")!;
      const mount = this.querySelector<HTMLElement>(".search-mount")!;
      const hint = this.querySelector<HTMLElement>(".search-hint")!;
      trigger.querySelector("kbd")!.textContent = /Mac|iPhone|iPad/.test(
        navigator.userAgent,
      )
        ? "⌘ K"
        : "Ctrl K";
      let initialization: Promise<void> | undefined;
      const initialize = async () => {
        try {
          // Pagefind supplies the UI at runtime; it does not publish TypeScript declarations.
          // @ts-expect-error Missing declarations for @pagefind/default-ui.
          const { PagefindUI } = await import("@pagefind/default-ui");
          // Pagefind mounts its interface through the constructor.
          // eslint-disable-next-line no-new
          new PagefindUI({
            element: mount,
            bundlePath: `${import.meta.env.BASE_URL.replace(/\/$/, "")}/pagefind/`,
            baseUrl: import.meta.env.BASE_URL,
            showImages: false,
            showSubResults: false,
            translations: {
              placeholder: "What are you looking for?",
              clear_search: "Clear",
            },
          });
          mount.addEventListener("input", () => {
            hint.hidden =
              !!mount.querySelector<HTMLInputElement>("input")?.value;
          });
        } catch {
          initialization = undefined;
          hint.textContent = "Search is unavailable. Try reloading the page.";
        }
      };
      const open = async () => {
        if (dialog.open) return;
        dialog.showModal();
        initialization ??= initialize();
        await initialization;
        if (dialog.open)
          mount.querySelector<HTMLInputElement>("input")?.focus();
      };
      trigger.addEventListener("click", open);
      close.addEventListener("click", () => dialog.close());
      dialog.addEventListener("click", (event) => {
        if (event.target === dialog) {
          const rect = dialog.getBoundingClientRect();
          if (
            event.clientX < rect.left ||
            event.clientX > rect.right ||
            event.clientY < rect.top ||
            event.clientY > rect.bottom
          )
            dialog.close();
        }
        if (event.target instanceof Element && event.target.closest("a"))
          dialog.close();
      });
      dialog.addEventListener("close", () => trigger.focus());
      window.addEventListener("keydown", (event) => {
        if (
          (event.metaKey || event.ctrlKey) &&
          event.key.toLowerCase() === "k"
        ) {
          event.preventDefault();
          if (dialog.open) dialog.close();
          else void open();
        }
      });
    }
  }
  if (!customElements.get("lucent-search"))
    customElements.define("lucent-search", LucentSearch);
</script>

<style>
  lucent-search {
    --search-bg: light-dark(#fcfdf9, #161b13);
    --search-ink: light-dark(#20271a, #eef2e8);
    --search-muted: light-dark(#67705e, #aab69e);
    --search-line: light-dark(#dce3d4, #35412b);
    --search-accent: light-dark(#4d741b, #c4f85a);
    --search-hover: light-dark(#f0f6e7, #222e18);
    font-family: "Geist", system-ui, sans-serif;
  }
  .search-open {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 8px 11px;
    border: 1px solid var(--search-line);
    border-radius: 6px;
    color: var(--search-muted);
    background: transparent;
    font: inherit;
    font-size: 12px;
    cursor: pointer;
  }
  kbd {
    font-family: "Geist Mono", monospace;
    font-size: 10px;
    color: var(--search-muted);
  }
  dialog {
    width: min(640px, calc(100vw - 32px));
    max-width: none;
    max-height: calc(100dvh - 80px);
    margin: min(12vh, 100px) auto auto;
    padding: 0;
    border: 1px solid var(--search-line);
    border-radius: 14px;
    background: var(--search-bg);
    color: var(--search-ink);
    box-shadow: 0 24px 90px #0003;
  }
  dialog[open] {
    display: flex;
    flex-direction: column;
  }
  dialog::backdrop {
    background: #10150db3;
    backdrop-filter: blur(5px);
  }
  .search-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 17px 21px 8px;
    font:
      500 10px "Geist Mono",
      monospace;
    letter-spacing: 0.08em;
    color: var(--search-muted);
  }
  .search-close {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 7px 0 7px 10px;
    border: 0;
    background: none;
    color: var(--search-muted);
    font:
      400 12px "Geist",
      sans-serif;
    cursor: pointer;
  }
  .search-body {
    padding: 5px 16px 16px;
    overflow-y: auto;
    min-height: 0;
  }
  .search-hint {
    padding: 28px 5px;
    margin: 0;
    color: var(--search-muted);
    font-size: 13px;
  }
  .search-footer {
    display: flex;
    justify-content: space-between;
    gap: 15px;
    padding: 13px 21px;
    border-top: 1px solid var(--search-line);
    font-size: 11px;
    color: var(--search-muted);
  }
  lucent-search .search-mount :global(.pagefind-ui) {
    --pagefind-ui-scale: 0.85;
    --pagefind-ui-primary: var(--search-accent);
    --pagefind-ui-text: var(--search-ink);
    --pagefind-ui-background: var(--search-bg);
    --pagefind-ui-border: var(--search-line);
    --pagefind-ui-font: "Geist", system-ui, sans-serif;
  }
  lucent-search .search-mount :global(.pagefind-ui__search-input) {
    height: 52px;
    border: 1px solid var(--search-line);
    border-radius: 8px;
    padding-left: 45px;
    padding-right: 65px;
    font-size: 16px;
    font-weight: 400;
  }
  lucent-search .search-mount :global(.pagefind-ui__search-input:focus) {
    outline: 2px solid var(--search-accent);
    outline-offset: 2px;
  }
  lucent-search .search-mount :global(.pagefind-ui__form::before) {
    top: 18px;
    left: 17px;
    width: 16px;
    height: 16px;
    opacity: 0.65;
  }
  lucent-search .search-mount :global(.pagefind-ui__search-clear) {
    top: 7px;
    right: 7px;
    height: 38px;
    width: auto;
    padding: 0 10px;
    font-size: 12px;
    border-radius: 4px;
    color: var(--search-muted);
  }
  lucent-search .search-mount :global(.pagefind-ui__message) {
    padding: 20px 5px 10px;
    height: auto;
    font-size: 12px;
    color: var(--search-muted);
    font-weight: 400;
  }
  lucent-search .search-mount :global(.pagefind-ui__results) {
    padding: 0;
    margin: 0;
  }
  lucent-search .search-mount :global(.pagefind-ui__result) {
    padding: 16px 10px !important;
    border-bottom: 1px solid var(--search-line);
    border-top: 0 !important;
    border-radius: 0;
  }
  lucent-search .search-mount :global(.pagefind-ui__result:hover),
  lucent-search .search-mount :global(.pagefind-ui__result:focus-within) {
    background: var(--search-hover);
  }
  lucent-search .search-mount :global(.pagefind-ui__result-inner) {
    margin: 0 !important;
  }
  lucent-search .search-mount :global(.pagefind-ui__result-title) {
    font-size: 16px;
    line-height: 1.4;
    font-weight: 500;
  }
  lucent-search .search-mount :global(.pagefind-ui__result-link) {
    color: var(--search-ink);
  }
  lucent-search .search-mount :global(.pagefind-ui__result-link:focus-visible) {
    outline: 2px solid var(--search-accent);
    outline-offset: 3px;
  }
  lucent-search .search-mount :global(.pagefind-ui__result-excerpt) {
    margin-top: 7px;
    display: -webkit-box !important;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
    font-size: 13px;
    line-height: 1.65;
    color: var(--search-muted);
    overflow-wrap: anywhere;
  }
  lucent-search .search-mount :global(mark) {
    background: color-mix(in srgb, var(--search-accent) 16%, transparent);
    color: var(--search-ink);
    border-radius: 2px;
    padding: 0 2px;
  }
  lucent-search .search-mount :global(.pagefind-ui__button) {
    border: 1px solid var(--search-line);
    font-size: 13px;
    border-radius: 6px;
  }
  :global(html:has(lucent-search dialog[open])) {
    overflow: hidden;
  }
  @media (max-width: 600px) {
    dialog {
      width: calc(100vw - 20px);
      margin: 10px auto;
      max-height: calc(100dvh - 20px);
    }
    .search-footer {
      flex-wrap: wrap;
      gap: 6px;
    }
    .search-heading {
      padding-inline: 17px;
    }
    .search-body {
      padding-inline: 12px;
    }
    .search-close {
      min-height: 44px;
    }
    .search-open {
      gap: 12px;
    }
    .search-open kbd {
      display: none;
    }
  }
</style>
