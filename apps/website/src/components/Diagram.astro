---
/**
 * A docs diagram by name, with its caption (the element's content):
 * <Diagram name="threads">What runs where.</Diagram>. The diagrams are
 * hand-laid SVG (diagrams/*.tsx), rendered at build time.
 */
import type { DiagramName } from "../docs/types";
import { BuildDiagram } from "./diagrams/BuildDiagram";
import { CallDiagram } from "./diagrams/CallDiagram";
import { PlacesDiagram } from "./diagrams/PlacesDiagram";
import { PlatformCallDiagram } from "./diagrams/PlatformCallDiagram";
import { ThreadsDiagram } from "./diagrams/ThreadsDiagram";

interface Props {
  name: DiagramName;
}

const { name } = Astro.props;
const step = { "build-check": 1, "build-cpp": 2, "build-package": 3, "build-app": 4, "build-metro": 5 } as const;
---

<figure class="lucent-diagram not-content">
  {name in step && <BuildDiagram step={step[name as keyof typeof step]} />}
  {name === "call-sync" && <CallDiagram mode="sync" />}
  {name === "call-async" && <CallDiagram mode="async" />}
  {name === "platform-call" && <PlatformCallDiagram />}
  {name === "places" && <PlacesDiagram />}
  {name === "threads" && <ThreadsDiagram />}
  {Astro.slots.has("default") && <figcaption><slot /></figcaption>}
</figure>
