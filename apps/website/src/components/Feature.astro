---
/**
 * One feature on the homepage: an icon, a short title, a few lines, and
 * where to read more. Lay several out with <div class="features">.
 */
import { Icon } from "@astrojs/starlight/components";
import type { ComponentProps } from "astro/types";

interface Props {
  title: string;
  icon: ComponentProps<typeof Icon>["name"];
  href: string;
  link: string;
}

const { title, icon, href, link } = Astro.props;
---

<article class="feature">
  <span class="icon"><Icon name={icon} size="1.25rem" /></span>
  <h3>{title}</h3>
  <div class="body"><slot /></div>
  <a href={href}>{link} <span aria-hidden="true">→</span></a>
</article>

<style>
  .feature {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.25rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    background: var(--sl-color-gray-7, var(--sl-color-black));
  }
  .icon {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.5rem;
    background: var(--sl-color-accent-low);
    color: var(--sl-color-accent-high);
  }
  h3 {
    margin: 0.25rem 0 0;
    color: var(--sl-color-white);
    font-size: var(--sl-text-lg);
    font-weight: 600;
    line-height: 1.3;
  }
  .body {
    flex: 1;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
    line-height: 1.6;
  }
  .body :global(p) {
    margin: 0;
  }
  a {
    color: var(--sl-color-white);
    font-size: var(--sl-text-sm);
    font-weight: 500;
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
  }
</style>
