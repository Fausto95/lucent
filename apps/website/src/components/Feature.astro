---
/**
 * One feature on the homepage: an icon, a short title, a few lines, and
 * where to read more. Lay several out with <div class="features">.
 */
import { Icon } from "@astrojs/starlight/components";
import type { ComponentProps } from "astro/types";

interface Props {
  title: string;
  icon: ComponentProps<typeof Icon>["name"];
  href: string;
  link: string;
}

const { title, icon, href, link } = Astro.props;
---

<article class="feature">
  <span class="icon"><Icon name={icon} size="1.25rem" /></span>
  <h3>{title}</h3>
  <div class="body"><slot /></div>
  <a href={href}>{link} <span aria-hidden="true">→</span></a>
</article>

<style>
  .feature {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: var(--card);
    transition:
      border-color 0.2s,
      translate 0.2s,
      box-shadow 0.2s;
  }
  .feature:hover {
    border-color: color-mix(in oklab, var(--lucent-lime-ink) 45%, var(--border));
    translate: 0 -2px;
    box-shadow: 0 18px 40px -24px var(--lucent-glow-strong);
  }
  .icon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid color-mix(in oklab, var(--lucent-lime-ink) 30%, transparent);
    border-radius: 0.625rem;
    background: color-mix(in oklab, var(--lucent-lime) 22%, transparent);
    color: var(--lucent-lime-ink);
  }
  h3 {
    margin: 0.5rem 0 0;
    color: var(--foreground-light);
    font-size: var(--sl-text-lg);
    font-weight: 600;
    line-height: 1.3;
  }
  .body {
    flex: 1;
    color: var(--muted-foreground);
    font-size: var(--sl-text-sm);
    line-height: 1.6;
  }
  .body :global(p) {
    margin: 0;
  }
  a {
    color: var(--foreground-light);
    font-size: var(--sl-text-sm);
    font-weight: 500;
    text-decoration: none;
  }
  /* The whole card is the link's target. */
  a::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  a span {
    display: inline-block;
    transition: translate 0.2s;
  }
  .feature:hover a span {
    translate: 3px 0;
  }
  a:focus-visible {
    outline: none;
  }
  .feature:has(a:focus-visible) {
    outline: 2px solid var(--lucent-lime-ink);
    outline-offset: 2px;
  }
</style>
