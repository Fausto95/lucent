---
import "@fontsource/geist/400.css";
import "@fontsource/geist/500.css";
import "@fontsource/geist/600.css";
import "@fontsource/geist/700.css";
import "@fontsource/geist-mono/400.css";
import "../styles/home.css";
import Search from "../components/overrides/Search.astro";
import { loadPosts } from "../blog/load";
import { SITE } from "../blog/meta";
const [latest] = await loadPosts();
const title = "Lucent — native logic and views in TypeScript";
const description =
  "Native logic and views for React Native, written in TypeScript. Compile functions to C++ and write SwiftUI and Jetpack Compose bodies in JSX.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={SITE} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Lucent blog"
      href="/blog/rss.xml"
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={SITE} />
    <meta property="og:image" content={`${SITE}/og.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      try {
        const theme = localStorage.getItem("starlight-theme");
        if (theme === "light" || theme === "dark")
          document.documentElement.style.colorScheme = theme;
      } catch {}
    </script>
  </head>
  <body>
    <div id="voltage-home">
      <a class="skip-link" href="#main-content">
        Skip to content
      </a>
      <nav class="wrap" aria-label="Main navigation">
        <a class="logo" href="/" aria-label="Lucent home">
          <span class="mark"></span>lucent
        </a>
        <div class="navlinks">
          <Search />
          <button
            class="nav-toggle"
            type="button"
            aria-label="Toggle navigation"
            aria-expanded="false"
            aria-controls="home-menu"
          >
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
            >
              <path d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
          <div class="nav-menu" id="home-menu">
            <a href="/docs/">Docs</a>
            <a class="optional" href="/docs/examples/">
              Examples
            </a>
            <a class="optional" href="/blog/">
              Blog
            </a>
            <a class="nav-start" href="/docs/install/">
              Get started ↗
            </a>
          </div>
        </div>
      </nav>

      <div class="hero-announcement">
        <span class="hero-status">EXPERIMENTAL</span>
        <a class="hero-blog" href={latest ? `/blog/${latest.slug}/` : "/blog/"}>
          <span>
            <span class="news-label">LATEST FROM THE BLOG</span>
            <span class="news-title">
              {latest?.title ?? "Read the Lucent blog"}
            </span>
          </span>
          <span class="news-action">Read the announcement ↗</span>
        </a>
      </div>
      <main id="main-content">
        <header class="hero wrap">
          <div class="eyebrow mono">TYPESCRIPT → NATIVE CODE</div>
          <div class="beam" aria-hidden="true">
            <i></i>
            <i></i>
            <i></i>
            <i></i>
            <i></i>
          </div>
          <h1>
            Write TypeScript.
            <br />
            <em>Run native.</em>
          </h1>
          <div class="hero-bottom">
            <p class="intro">
              Native logic and views for React Native, written in TypeScript.
              From compiled functions to SwiftUI and Jetpack Compose.
            </p>
            <div class="actions">
              <a class="cta" href="/docs/install/">
                Start building <span>↗</span>
              </a>
              <a href="/docs/how-it-works/">How it works →</a>
            </div>
          </div>
          <div class="codebox hero-code">
            <div class="codepane">
              <div class="code-label mono">
                <span>YOU WRITE</span>
                <span>math.lucent.ts</span>
              </div>
              <pre
                is:raw
              ><span class="kw">export function</span> square(x: number) {
  <span class="kw">return</span> x * x;
}</pre>
            </div>
            <div class="codepane">
              <div class="code-label mono">
                <span>YOUR APP CALLS</span>
                <span>App.tsx</span>
              </div>
              <pre
                is:raw
              ><span class="kw">import</span> { square } <span class="kw">from</span> './math.lucent';

square(5); <span class="kw">// 25. Runs in C++.</span></pre>
            </div>
          </div>
        </header>
        <div class="support wrap mono">
          <span>iOS + Android</span>
          <span>Expo + React Native</span>
          <span>Modules through JSI · Views through Fabric</span>
        </div>

        <section class="views-showcase wrap">
          <div class="views-title">
            <p class="kicker mono">NATIVE VIEWS / NOW IN LUCENT</p>
            <span class="experimental">EXPERIMENTAL</span>
          </div>
          <h2>
            TypeScript logic.
            <br />
            <span>Each platform’s own UI.</span>
          </h2>
          <div class="view-grid">
            <div class="view-code">
              <div class="code-label mono">
                <span>like.lucent.tsx</span>
                <span>EXCERPT</span>
              </div>
              <pre
                is:raw
              ><span class="comment">// Shared logic, compiled to C++.</span>
<span class="kw">const</span> liked = signal(false);
<span class="kw">const</span> toggle = () =&gt; liked.set(!liked.get());
<span class="kw">const</span> count = () =&gt;
  props.count + (liked.get() ? 1 : 0);</pre>
              <div
                class="code-switch"
                role="group"
                aria-label="View code platform"
              >
                <button
                  type="button"
                  class="cursor-interaction"
                  data-platform="swiftui"
                  aria-pressed="true"
                  aria-controls="voltage-swiftui"
                >
                  SwiftUI
                </button>
                <button
                  type="button"
                  class="cursor-interaction"
                  data-platform="compose"
                  aria-pressed="false"
                  aria-controls="voltage-compose"
                >
                  Jetpack Compose
                </button>
              </div>
              <pre
                is:raw
                id="voltage-swiftui"
              ><span class="kw">if</span> (PLATFORM === "ios") {
  <span class="kw">return</span> (
    &lt;HStack spacing={6} onTapGesture={toggle}&gt;
      &lt;Image systemName={
        liked.get() ? "heart.fill" : "heart"
      } /&gt;
      &lt;Text font={Font.headline}&gt;
        {`${count()}`}
      &lt;/Text&gt;
    &lt;/HStack&gt;
  );
}</pre>
              <pre
                is:raw
                id="voltage-compose"
                hidden
              ><span class="kw">return</span> (
  &lt;Row
    horizontalArrangement={
      Arrangement.spacedBy(dp(8))
    }
    verticalAlignment={Alignment.CenterVertically}
    modifier={Modifier.clickable(toggle)}
  &gt;
    &lt;CText text={liked.get() ? "♥" : "♡"}
      fontSize={sp(24)} /&gt;
    &lt;CText text={`${count()}`}
      fontSize={sp(17)}
      fontWeight={FontWeight.Bold} /&gt;
  &lt;/Row&gt;
);</pre>
            </div>
            <div class="view-demos">
              <div class="device">
                <span class="device-name">LIVE PREVIEW</span>
                <button
                  class="like-preview cursor-interaction"
                  type="button"
                  aria-label="Like"
                  aria-pressed="false"
                >
                  <span class="heart" aria-hidden="true">
                    ♡
                  </span>
                  <strong aria-live="polite">41</strong>
                </button>
                <small>One component. Each platform’s own UI.</small>
              </div>
              <div class="view-import">
                <div class="code-label mono">
                  <span>ONE IMPORT IN REACT</span>
                  <span>App.tsx</span>
                </div>
                <pre
                  is:raw
                ><span class="kw">import</span> { Like } <span class="kw">from</span> './like.lucent';

&lt;Like count={41} /&gt;</pre>
              </div>
              <p class="view-note">Tap the heart to try the interaction.</p>
            </div>
          </div>
          <div class="view-foot">
            <p class="bodycopy">
              Write the logic once. Write each platform’s body in JSX. Lucent
              generates C++ for the logic and Swift or Kotlin for the UI.
            </p>
            <a class="textlink" href="/blog/native-views/">
              Meet native views ↗
            </a>
          </div>
          <p class="view-note">
            Views currently require LUCENT_VIEWS=fabric. The API is experimental
            and off by default.
          </p>
        </section>
        <section class="section wrap">
          <div class="section-head">
            <div>
              <p class="kicker mono">01 / HOW IT COMES TOGETHER</p>
              <h2>
                One language.
                <br />
                <span>Native all the way down.</span>
              </h2>
            </div>
            <a href="/docs/how-it-works/">Inside the compiler ↗</a>
          </div>
          <div class="three">
            <article class="feature">
              <p class="number mono">01 — WRITE</p>
              <h3>Stay in TypeScript.</h3>
              <p class="bodycopy">
                Write your module in a checked TypeScript subset. Familiar
                types, functions, classes, and JavaScript behavior.
              </p>
            </article>
            <article class="feature">
              <p class="number mono">02 — COMPILE</p>
              <h3>Get native C++.</h3>
              <p class="bodycopy">
                Lucent generates C++20 that builds with your app. Unsupported
                features surface as clear build-time diagnostics.
              </p>
            </article>
            <article class="feature">
              <p class="number mono">03 — CALL</p>
              <h3>Import. Call. Done.</h3>
              <p class="bodycopy">
                A typed proxy connects your app to the compiled module through
                JSI. Synchronous calls return inline.
              </p>
            </article>
          </div>

          <div class="architecture">
            <div class="architecture-label mono">
              ONE LANGUAGE. NATIVE ON BOTH SIDES.
            </div>
            <div class="architecture-content">
              <div>
                <svg
                  class="stack-art"
                  viewBox="40 -32 640 535"
                  role="img"
                  aria-labelledby="voltage-stack-title voltage-stack-desc"
                >
                  <title id="voltage-stack-title">Lucent, compiled for iOS and Android</title>
                  <desc id="voltage-stack-desc">
                    Gently floating blocks labeled lucent, C++20, iOS, and
                    Android. Lucent compiles native logic and generates platform
                    UI. Animation is disabled when reduced motion is preferred.
                  </desc>
                  <g class="float-ios">
                    <g class="edge">
                      <path
                        class="baseside"
                        d="M100 360 L262 450 L262 490 L100 400 Z"
                      />
                      <path
                        class="baseside"
                        d="M262 450 L432 352 L432 392 L262 490 Z"
                      />
                      <path
                        class="baseface"
                        d="M100 360 L270 262 L432 352 L262 450 Z"
                      />
                    </g>
                    <text
                      class="base-label"
                      text-anchor="middle"
                      dominant-baseline="middle"
                      transform="translate(347 421) rotate(-30)"
                    >
                      iOS
                    </text>
                  </g>
                  <g class="float-android">
                    <g class="edge">
                      <path
                        class="baseside"
                        d="M306 241 L468 331 L468 371 L306 281 Z"
                      />
                      <path
                        class="baseside"
                        d="M468 331 L638 233 L638 273 L468 371 Z"
                      />
                      <path
                        class="baseface"
                        d="M306 241 L476 143 L638 233 L468 331 Z"
                      />
                    </g>
                    <text
                      class="base-label"
                      text-anchor="middle"
                      dominant-baseline="middle"
                      transform="translate(553 302) rotate(-30)"
                    >
                      Android
                    </text>
                  </g>
                  <g class="float-logic">
                    <g class="edge">
                      <path
                        fill="#b0d95e"
                        d="M100 290 L262 380 L262 420 L100 330 Z"
                      />
                      <path
                        fill="#c4f85a"
                        d="M262 380 L638 163 L638 203 L262 420 Z"
                      />
                      <path
                        fill="#e0ff9f"
                        d="M100 290 L476 73 L638 163 L262 380 Z"
                      />
                    </g>
                    <text
                      class="logictext"
                      text-anchor="middle"
                      dominant-baseline="middle"
                      transform="translate(450 291.5) rotate(-30)"
                    >
                      C++20
                    </text>
                  </g>
                  <g class="float-source">
                    <g class="edge">
                      <path
                        class="sideface"
                        d="M100 210 L262 300 L262 340 L100 250 Z"
                      />
                      <path
                        class="sideface"
                        d="M262 300 L638 83 L638 123 L262 340 Z"
                      />
                      <path
                        class="topface"
                        d="M100 210 L476 -7 L638 83 L262 300 Z"
                      />
                    </g>
                    <text
                      class="slabtext"
                      text-anchor="middle"
                      dominant-baseline="middle"
                      transform="translate(369 146.5) rotate(-30)"
                    >
                      lucent
                    </text>
                  </g>
                </svg>
              </div>
              <div class="architecture-legend">
                <div>
                  <p class="stack-source mono">.lucent.ts + .lucent.tsx</p>
                  <b>One source language.</b>
                  <p>Write native functions and components in TypeScript.</p>
                </div>
                <div>
                  <b>Compiled native logic.</b>
                  <p>
                    C++20 powers your modules and view logic. JSI connects
                    module calls to React Native.
                  </p>
                </div>
                <div>
                  <b>Each platform’s own UI.</b>
                  <p>
                    Toolkit JSX becomes SwiftUI or Compose source. Fabric brings
                    your views into the app.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </section>

        <section class="compatibility wrap" aria-label="Platform compatibility">
          <div class="compat-heading">
            <h2>Fits the app you already have.</h2>
            <a href="/docs/install/">Find your setup ↗</a>
          </div>
          <div class="compat-line">
            <div class="compat-brand">
              <span class="brand-icon brand-react" aria-hidden="true"></span>
              <div>
                <strong>React Native</strong>
                <span>Bare applications</span>
              </div>
            </div>
            <div class="compat-brand">
              <span class="brand-icon brand-expo" aria-hidden="true"></span>
              <div>
                <strong>Expo</strong>
                <span>Development builds</span>
              </div>
            </div>
          </div>
        </section>

        <section class="section wrap faq">
          <div>
            <p class="kicker mono">02 / A FEW GOOD QUESTIONS</p>
            <h2>
              Know what
              <br />
              you’re building on.
            </h2>
          </div>
          <div>
            <details open>
              <summary>Is this all of TypeScript?</summary>
              <p class="bodycopy">
                Lucent compiles a checked subset. Supported features follow
                JavaScript semantics; unsupported features produce LUCENT
                diagnostics at build time.{" "}
                <a class="textlink" href="/docs/reference/language/">
                  Read the language reference →
                </a>
              </p>
            </details>
            <details>
              <summary>Does JavaScript run on the native side?</summary>
              <p class="bodycopy">
                No. Module logic compiles to C++20 and is called through JSI.
                View logic also compiles to C++; SwiftUI and Compose bodies
                become Swift and Kotlin, hosted by Fabric.
              </p>
            </details>
            <details>
              <summary>Can I use it with Expo?</summary>
              <p class="bodycopy">
                Yes, with an Expo development build. Lucent includes native
                code, so it requires a native build and does not run in Expo Go.
              </p>
            </details>
            <details>
              <summary>
                How does it compare to other native module tools?
              </summary>
              <p class="bodycopy">
                Lucent uses a native JSI call path while letting you author
                modules in TypeScript.{" "}
                <a class="textlink" href="/docs/comparison/">
                  Compare with Expo Modules, Nitro, and TurboModules →
                </a>
              </p>
            </details>
          </div>
        </section>
        <section class="closing wrap">
          <div>
            <p class="kicker mono">YOUR LOGIC. YOUR VIEWS. YOUR LANGUAGE.</p>
            <h2>
              Let’s make
              <br />
              it native.
            </h2>
          </div>
          <div>
            <div class="terminal">
              <p class="mono">TERMINAL</p>
              <pre is:raw>npm install -D @lucent-lang/lucent
npx lucent init</pre>
            </div>
            <div class="setup">
              <span>Node 22.12+ · Native development build</span>
              <a href="/docs/install/">Full setup →</a>
            </div>
          </div>
        </section>
      </main>
      <footer class="wrap">
        <a class="logo" href="/" aria-label="Lucent home">
          <span class="mark"></span>lucent
        </a>
        <span class="tag">Native logic. Native views. TypeScript.</span>
        <div class="links">
          <a href="/docs/">Docs</a>
          <a href="/docs/examples/">Examples</a>
          <a href="/blog/">Blog ↗</a>
        </div>
      </footer>
    </div>

    <script>
      const navToggle =
        document.querySelector<HTMLButtonElement>(".nav-toggle")!;
      const homeNav = navToggle.closest("nav")!;
      const closeNavigation = () =>
        navToggle.setAttribute("aria-expanded", "false");
      navToggle.addEventListener("click", () => {
        navToggle.setAttribute(
          "aria-expanded",
          String(navToggle.getAttribute("aria-expanded") !== "true"),
        );
      });
      document.addEventListener("click", (event) => {
        if (event.target instanceof Node && !homeNav.contains(event.target))
          closeNavigation();
      });
      homeNav.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          closeNavigation();
          navToggle.focus();
        }
      });
      document
        .querySelector("#home-menu")
        ?.addEventListener("click", closeNavigation);
      matchMedia("(min-width: 761px)").addEventListener(
        "change",
        closeNavigation,
      );

      const root = document.getElementById("voltage-home")!;
      const like = root.querySelector<HTMLButtonElement>(".like-preview")!;
      const toggles = [
        ...root.querySelectorAll<HTMLButtonElement>("[data-platform]"),
      ];
      let liked = false;
      like.addEventListener("click", () => {
        liked = !liked;
        like.setAttribute("aria-pressed", String(liked));
        like.querySelector(".heart")!.textContent = liked ? "♥" : "♡";
        like.querySelector("strong")!.textContent = liked ? "42" : "41";
      });
      for (const button of toggles) {
        button.addEventListener("click", () => {
          for (const toggle of toggles) {
            const selected = toggle === button;
            toggle.setAttribute("aria-pressed", String(selected));
            document.getElementById(
              toggle.getAttribute("aria-controls")!,
            )!.hidden = !selected;
          }
        });
      }
    </script>
  </body>
</html>
