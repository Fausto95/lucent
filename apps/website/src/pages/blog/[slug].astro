---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { render } from "astro:content";
import { blogSidebar, loadPosts } from "../../blog/load";
import { postHead } from "../../blog/meta";
import { formatDate } from "../../blog/types";

export async function getStaticPaths() {
  const posts = await loadPosts();
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post.entry);
const sidebar = await blogSidebar();
---

<StarlightPage
  frontmatter={{
    title: post.title,
    description: post.summary,
    head: postHead(post),
  }}
  headings={headings}
  sidebar={sidebar}
>
  <p class="byline"><time datetime={post.date}>{formatDate(post.date)}</time> · <a href="/blog/">Blog</a></p>
  <Content />
</StarlightPage>

<style>
  .byline {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }
</style>
