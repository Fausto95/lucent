{
  "name": "@lucent-lang/cli",
  "version": "0.0.1",
  "description": "The lucent command line: build, check, scaffold and diagnose native React Native modules written in TypeScript.",
  "keywords": [
    "cli",
    "compiler",
    "expo",
    "kotlin",
    "lucent",
    "nitro",
    "react-native",
    "swift"
  ],
  "homepage": "https://github.com/Fausto95/lucent#readme",
  "bugs": "https://github.com/Fausto95/lucent/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fausto95/lucent.git",
    "directory": "packages/cli"
  },
  "bin": {
    "lucent": "./dist/main.cjs"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@lucent-lang/compiler": "workspace:*",
    "@lucent-lang/host-core": "workspace:*",
    "@lucent-lang/host-expo": "workspace:*",
    "@lucent-lang/host-nitro": "workspace:*",
    "@lucent-lang/sdk": "workspace:*",
    "oxc-parser": "0.151.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
