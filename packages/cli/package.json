{
  "name": "@lucent-lang/cli",
  "version": "0.1.0-cpp",
  "description": "lucent build: compiles *.lucent.ts into a native React Native package",
  "license": "MIT",
  "type": "module",
  "bin": {
    "lucent": "./bin/lucent.cjs"
  },
  "dependencies": {
    "@lucent-lang/compiler": "workspace:*",
    "@lucent-lang/runtime": "workspace:*"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "tsx": "^4.20.6"
  }
}
