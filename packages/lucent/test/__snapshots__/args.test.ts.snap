exports[`help > describes a command's flags 1`] = `
"lucent build
  Build

Flags
  --force             Rebuild
  --platforms <list>  Targets
  --root <dir>        Project directory (default: the current one)
  --json              Machine-readable output, for tools and CI
  --help              Show help"
`;
