{
  "$id": "https://lucent-lang.dev/schemas/doctor.schema.json",
  "title": "lucent doctor --json",
  "type": "object",
  "required": ["ok", "checks"],
  "additionalProperties": false,
  "properties": {
    "ok": {
      "type": "boolean",
      "description": "No check failed; the exit code is 0 exactly then"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "status", "detail"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable: node, package-manager, react-native, expo, xcode, simulator, cocoapods, android-sdk, ndk, jdk, gradle-task, metro, tsconfig, sdk-cache, versions"
          },
          "label": {
            "type": "string"
          },
          "status": {
            "enum": ["ok", "warn", "fail", "skip"]
          },
          "detail": {
            "type": "string"
          },
          "fix": {
            "type": "string",
            "description": "What to do about a failure or warning"
          }
        }
      }
    }
  }
}
