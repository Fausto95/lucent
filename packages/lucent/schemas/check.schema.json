{
  "$id": "https://lucent-lang.dev/schemas/check.schema.json",
  "title": "lucent check --json",
  "type": "object",
  "required": ["ok", "modules", "diagnostics", "errors", "ms"],
  "additionalProperties": false,
  "properties": {
    "ok": {
      "type": "boolean",
      "description": "No errors; the exit code is 0 exactly then"
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Module names, as JavaScript loads them"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^LUCENT\\d{4}$",
            "description": "Stable code; lucent explain <code> describes it"
          },
          "message": {
            "type": "string"
          },
          "file": {
            "type": "string",
            "description": "Relative to the project root"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "column": {
            "type": "integer",
            "minimum": 1
          },
          "start": {
            "type": "integer",
            "minimum": 0,
            "description": "Offset of the span in the file"
          },
          "length": {
            "type": "integer",
            "minimum": 0
          },
          "fix": {
            "type": "string",
            "description": "How to fix it, in one line"
          },
          "docs": {
            "type": "string",
            "description": "Where the code is explained"
          }
        }
      }
    },
    "errors": {
      "type": "integer",
      "minimum": 0
    },
    "ms": {
      "type": "number",
      "minimum": 0
    }
  }
}
