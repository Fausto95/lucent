{
  "name": "@lucent-lang/compiler",
  "version": "0.1.0-cpp",
  "description": "Compiles *.lucent.ts modules to C++ with JSI bindings",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@lucent-lang/bindgen": "workspace:*",
    "@lucent-lang/runtime": "workspace:*",
    "@lucent-lang/sdk-android": "workspace:*",
    "@lucent-lang/sdk-ios": "workspace:*",
    "typescript": "~5.9.3"
  },
  "files": [
    "dist",
    "lib"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
