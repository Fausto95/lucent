{
  "ios": {
    "nativeSources": ["native"]
  },
  "android": {
    "nativeSources": ["native"]
  },
  "extensions": {
    "ticker": {
      "header": "native/ticker.h",
      "handles": {
        "Ticker": {
          "create": "ticker_create",
          "destroy": "ticker_destroy",
          "methods": {
            "onTick": "ticker_on_tick",
            "tick": "ticker_tick"
          }
        }
      },
      "functions": {
        "ticker_create": {
          "failsWhen": "null"
        },
        "ticker_count": {
          "params": {
            "visit": {
              "callback": {
                "context": "context"
              }
            }
          }
        },
        "ticker_keep": {
          "params": {
            "names": {
              "string": "utf8"
            },
            "keep": {
              "callback": {
                "context": "context"
              }
            }
          }
        },
        "ticker_later": {
          "params": {
            "done": {
              "callback": {
                "context": "context",
                "lives": "once"
              }
            }
          }
        },
        "ticker_on_tick": {
          "params": {
            "tick": {
              "callback": {
                "context": "context",
                "lives": "ticker"
              }
            }
          }
        },
        "ticker_count_threaded": {
          "params": {
            "visit": {
              "callback": {
                "context": "context"
              }
            }
          }
        },
        "ticker_check": {
          "params": {
            "ok": {
              "callback": {
                "context": "context"
              }
            },
            "error": {
              "error": "TickerError"
            }
          },
          "failsWhen": "negative"
        },
        "ticker_steps": {
          "params": {
            "step": {
              "callback": {
                "context": "context"
              }
            },
            "stop": {
              "signal": "flag"
            }
          }
        }
      },
      "errors": {
        "TickerError": {
          "code": "code",
          "message": "message"
        }
      }
    }
  }
}
