{
  "schemaVersion": 1,
  "package": "@lucent-lang/sqlite",
  "objects": {
    "SQLiteDatabase": {
      "ownership": "owned",
      "executor": "caller",
      "transferable": true,
      "close": "close",
      "cancellation": "cooperative"
    },
    "SQLiteTransaction": {
      "ownership": "external",
      "executor": "caller"
    }
  },
  "callbacks": {
    "SQLiteDatabase.transaction": {
      "retention": "call",
      "executor": "caller",
      "errors": "propagate"
    }
  }
}
