{
  "schemaVersion": 1,
  "package": "@lucent-lang/location",
  "objects": {
    "LocationProvider": {
      "ownership": "owned",
      "executor": "caller",
      "transferable": true,
      "close": "close",
      "cancellation": "cooperative"
    },
    "Position": {
      "ownership": "external",
      "executor": "caller"
    }
  },
  "callbacks": {
    "LocationProvider.updates": {
      "retention": "subscription",
      "executor": "worker",
      "errors": "notify",
      "backpressure": "latest"
    }
  }
}
