  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fausto95/lucent.git",
    "directory": "packages/expo"
  },
  "files": [
    "app.plugin.js",
    "dist",
    "src",
    "public.d.ts"
  ],
