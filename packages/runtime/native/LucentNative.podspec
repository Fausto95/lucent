# Generated by Lucent. Do not edit.
# The project's directory, relative to this package's (lucent build writes
# it). Generated code names its sources relative to it, and the build maps
# it to "." (debug information, __FILE__), so no machine's path reaches the
# binary: a debugger maps "." back with a source map.
lucent_project = "../.."
lucent_root = File.expand_path(lucent_project, __dir__)
lucent_root = File.realpath(lucent_root) if File.exist?(lucent_root)
lucent_prefix_map = "-ffile-prefix-map=\"#{lucent_root}\"=."

# This package's directory relative to the project, for the build phase
# below: named when lucent build was told another one than .lucent/native.
require "pathname"
lucent_out = Pathname.new(File.realpath(__dir__)).relative_path_from(Pathname.new(lucent_root)).to_s
lucent_out_flag = lucent_out == ".lucent/native" ? "" : " --out \"#{lucent_out}\""

# What pod install saw: this podspec and the sources it lists, as a digest.
# CocoaPods lists a pod's files at pod install, so lucent build, run by the
# build phase below, fails when either changed since: the build would miss
# a new file. lucent build computes the same digest (podSourcesDigest).
# Without the record (a read-only package), the build can't tell.
require "digest"
lucent_sources = Dir.glob("{cpp,ios,packages}/**/*.{c,cc,cpp,m,mm,swift}", base: __dir__)
  .reject { |f| f.start_with?("cpp/generated/android/", "cpp/generated/host/") }
  .sort
lucent_record = Digest::SHA256.hexdigest(([File.binread(__FILE__)] + lucent_sources.map(&:b)).join("\n".b))
File.write(File.join(__dir__, ".pod-install"), "#{lucent_record}\n") rescue nil

Pod::Spec.new do |s|
  s.name         = "LucentNative"
  s.version      = "0.1.0"
  s.summary      = "Native modules compiled by Lucent from *.lucent.ts"
  s.homepage     = "https://github.com/Fausto95/lucent"
  s.license      = "MIT"
  s.authors      = "Lucent"
  s.platforms    = { :ios => min_ios_version_supported }
  s.source       = { :git => "https://github.com/Fausto95/lucent.git", :tag => s.version.to_s }

  # Projects with platform modules generate one set of files per target
  # (cpp/generated/ios, cpp/generated/android); iOS builds its own. The
  # runtime's Android glue is guarded by __ANDROID__.
  s.source_files = ["cpp/**/*.{h,cpp,inc,c,mm}", "ios/**/*.{h,mm}"]
  s.exclude_files = ["cpp/generated/android/**", "cpp/generated/host/**"]
  # The one header the app sees, in the module `import LucentNative` gives
  # Swift: what the app's delegates forward to Lucent modules. The rest are
  # the pod's own, so the module carries no C++.
  s.public_header_files = "cpp/lucent/platform/LucentAppDelegate.h"
  # The runtime's core, prebuilt when the package has it (lucent build copies it for the
  # runtime it was built from): its sources are linked from the xcframework instead of
  # compiled. LUCENT_RUNTIME_FROM_SOURCE=1 at pod install compiles them.
  lucent_frameworks = []
  if File.directory?(File.join(__dir__, "prebuilt", "ios", "LucentCore.xcframework")) && ENV["LUCENT_RUNTIME_FROM_SOURCE"] != "1"
    s.exclude_files += File.readlines(File.join(__dir__, "prebuilt", "core-sources.txt"), chomp: true).reject(&:empty?)
    lucent_frameworks << "prebuilt/ios/LucentCore.xcframework"
  end
  s.vendored_frameworks = lucent_frameworks
  s.frameworks   = "CoreFoundation"
  s.header_mappings_dir = "cpp"
  # Every generated unit parses the runtime's umbrella header (the standard
  # library with it): Xcode precompiles the prefix header once, so an edited
  # module recompiles in about half the time. C sources see nothing of it.
  # A build whose check failed leaves no runtime yet (lucent build declares
  # the packages' pods first), and CocoaPods stops at a missing prefix header.
  s.prefix_header_file = "cpp/lucent/prefix.h" if File.exist?(File.join(__dir__, "cpp/lucent/prefix.h"))
  s.pod_target_xcconfig = {
    "CLANG_CXX_LANGUAGE_STANDARD" => "c++20",
    "DEFINES_MODULE" => "YES",
    "GCC_PRECOMPILE_PREFIX_HEADER" => "YES",
    "HEADER_SEARCH_PATHS" => "\"$(PODS_TARGET_SRCROOT)/cpp\" \"$(PODS_TARGET_SRCROOT)/cpp/generated/ios\" \"$(PODS_TARGET_SRCROOT)/cpp/generated\" \"$(PODS_TARGET_SRCROOT)/cpp/rn\"",
    # The vendored regular expression engine (third_party/quickjs) is C.
    # Hidden by default, as on Android: the runtime's and the vendored C's
    # symbols stay inside the app's binary (the C's are prefixed lucent_
    # too, third_party/quickjs/lucent_prefix.h). The TurboModule registers
    # itself at +load, so nothing is looked up by name.
    "OTHER_CFLAGS" => "$(inherited) -w -fvisibility=hidden #{lucent_prefix_map}",
    "OTHER_CPLUSPLUSFLAGS" => "$(inherited) #{lucent_prefix_map} -ffp-contract=off -fexceptions -frtti -fvisibility=hidden -fvisibility-inlines-hidden -Wno-gnu-statement-expression -Wno-unused-label -Wno-parentheses-equality -Wno-comma",
    # The build phase below reads and writes the project's files, which a sandbox would refuse.
    "ENABLE_USER_SCRIPT_SANDBOXING" => "NO",
  }

  # Every build of the app runs lucent build first, as Android's lucentBuild
  # task does: the native package matches the *.lucent.ts sources however
  # the app is built (Xcode, xcodebuild, CI), with Metro running or not.
  # React Native's .xcode.env names node, which Xcode's PATH may not have.
  # Xcode's SDK and deployment target settings are left out of the build:
  # clang would take them as its own.
  s.script_phase = {
    :name => "Lucent build",
    :execution_position => :before_compile,
    :always_out_of_date => "1",
    :script => <<~SH,
      set -e
      if [ -f "$PODS_ROOT/../.xcode.env" ]; then . "$PODS_ROOT/../.xcode.env"; fi
      if [ -f "$PODS_ROOT/../.xcode.env.local" ]; then . "$PODS_ROOT/../.xcode.env.local"; fi
      NODE="${NODE_BINARY:-node}"
      cd "$PODS_TARGET_SRCROOT/#{lucent_project}"
      LUCENT_PACKAGE=$("$NODE" --print "require.resolve('@lucent-lang/lucent/package.json')")
      env -u SDKROOT -u IPHONEOS_DEPLOYMENT_TARGET -u MACOSX_DEPLOYMENT_TARGET -u TVOS_DEPLOYMENT_TARGET -u XROS_DEPLOYMENT_TARGET \\
        LUCENT_XCODE_BUILD=1 LUCENT_NO_GRADLE=1 \\
        "$NODE" "$(dirname "$LUCENT_PACKAGE")/bin/lucent.cjs" build#{lucent_out_flag}
    SH
  }

  install_modules_dependencies(s)
end
